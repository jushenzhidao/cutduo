{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "science-explainer params",
  "type": "object",
  "required": [
    "segments"
  ],
  "additionalProperties": false,
  "properties": {
    "durationSeconds": {
      "type": "number",
      "minimum": 4,
      "maximum": 600,
      "description": "成片总时长（秒）；必须等于 segments 的 dur 累加，否则末段被截断"
    },
    "fps": {
      "type": "number",
      "minimum": 12,
      "maximum": 60
    },
    "fadeOutSeconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 3
    },
    "theme": {
      "type": "object",
      "description": "强调色。缺省继承内置色板；只改这里即可换品牌色，无需改源码",
      "properties": {
        "pop": {
          "type": "string",
          "description": "强调红（爆炸贴/病灶/划除线）"
        },
        "sun": {
          "type": "string",
          "description": "标签黄（荧光笔/圆卡底）"
        },
        "jade": {
          "type": "string",
          "description": "主青绿（标题条/勾选）"
        },
        "jadeDeep": {
          "type": "string",
          "description": "深青绿（标题条底）"
        },
        "blue": {
          "type": "string",
          "description": "辅助蓝（斜切标签/时钟）"
        },
        "ink": {
          "type": "string",
          "description": "正文墨色"
        }
      }
    },
    "brand": {
      "type": "object",
      "description": "左下角角标。show=false 或整段省略则不画",
      "properties": {
        "show": {
          "type": "boolean"
        },
        "text": {
          "type": "string",
          "maxLength": 16
        },
        "tag": {
          "type": "string",
          "maxLength": 28
        }
      }
    },
    "subtitle": {
      "type": "object",
      "description": "烧录字幕样式。参考片实测：白字 + 粗深色描边，居中，底部安全区",
      "properties": {
        "size": {
          "type": "number",
          "minimum": 32,
          "maximum": 96
        },
        "color": {
          "type": "string"
        },
        "stroke": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "strokeColor": {
          "type": "string"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "captions": {
      "type": "array",
      "description": "口播字幕时间轴；间隔留 0.1s 以上，避免相邻两条同时出现在画面",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "maxLength": 40
          },
          "speaker": {
            "type": "string",
            "maxLength": 12,
            "description": "说话人标识，对应 voices 的键；缺省用 default"
          },
          "seg": {
            "type": "integer",
            "minimum": 0,
            "description": "归属第几段（0 起）。留空则按 start 落在哪一段推断；显式指定更可靠，vo.py 优先用它"
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "description": "镜头序列，按数组顺序硬切；中位 2.75s/镜（参考片实测），信息型镜头 5–8s、讲解位 4–6s",
      "items": {
        "type": "object",
        "required": [
          "type",
          "dur"
        ],
        "properties": {
          "type": {
            "enum": [
              "cover",
              "talk",
              "diagram",
              "compare",
              "matrix",
              "focus",
              "tip",
              "outro"
            ],
            "description": "版式：cover 封面 / talk 讲解位 / diagram 圆框图解 / compare 对比 / matrix 图标阵列 / focus 单卡强调 / tip 便签 / outro 结尾"
          },
          "dur": {
            "type": "number",
            "minimum": 1,
            "maximum": 30
          },
          "note": {
            "type": "string",
            "description": "给编辑看的备注，不参与渲染"
          },
          "args": {
            "type": "object",
            "description": "版式参数，逐版式见 guide.json 的 layouts 字段"
          }
        }
      }
    },
    "audio": {
      "type": "string",
      "description": "配音音轨路径（由 tools/vo.py 生成）。仅作记录，渲染时仍需 --audio 显式传入"
    },
    "voices": {
      "type": "object",
      "description": "按角色映射 TTS 音色，如 {kid: zh-CN-YunxiaNeural, mom: zh-CN-XiaoxiaoNeural, default: ...}；captions[].speaker 指向这里的键",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}