  "captions": [
    {
      "start": 0.23,
      "end": 3.838,
      "zh": "南京，*六朝古都*，十朝都会。",
      "en": "Nanjing: six dynasties, ten capitals."
    },
    {
      "start": 3.938,
      "end": 7.09,
      "zh": "一条秦淮河，*流过一千年*。",
      "en": "The Qinhuai has run for a millennium."
    },
    {
      "start": 7.19,
      "end": 10.03,
      "zh": "玄武湖上，*船比人慢*。",
      "en": "On Xuanwu Lake, boats move slower than people."
    },
    {
      "start": 10.13,
      "end": 14.002,
      "zh": "城墙、梧桐、鸭子，*都是南京*。",
      "en": "Walls, plane trees, duck."
    },
    {
      "start": 14.102,
      "end": 17.278,
      "zh": "街角一块招牌，*写着金陵*。",
      "en": "A street sign that says Jinling."
    },
    {
      "start": 17.378,
      "end": 20.578,
      "zh": "夜里坐一次画舫，*才算到过*。",
      "en": "Take one night boat ride."
    },
    {
      "start": 20.678,
      "end": 23.686,
      "zh": "城墙亮起来，*水也跟着亮*。",
      "en": "The wall lights up, and so does the water."
    },
    {
      "start": 23.786,
      "end": 27.178,
      "zh": "明城墙现存 *25.1 公里*。",
      "en": "25.1 km of the Ming wall remains."
    },
    {
      "start": 27.278,
      "end": 30.694,
      "zh": "全长 35 公里，*留下七成*。",
      "en": "Of 35 km, seventy percent survives."
    },
    {
      "start": 30.794,
      "end": 33.922,
      "zh": "一张通票，*大半景点都到*。",
      "en": "One pass covers most sights."
    },
    {
      "start": 34.022,
      "end": 37.63,
      "zh": "地铁 15 条线，*483 公里*。",
      "en": "15 metro lines, 483 km."
    },
    {
      "start": 37.73,
      "end": 40.426,
      "zh": "这两处，*本地人也去*。",
      "en": "Locals go to these two."
    },
    {
      "start": 40.526,
      "end": 43.99,
      "zh": "鸡鸣寺的塔，*看着城墙六百年*。",
      "en": "Jiming Temple has watched the wall for 600 years."
    },
    {
      "start": 44.09,
      "end": 47.242,
      "zh": "十个朝代，*叠在一座城里*。",
      "en": "Ten dynasties stacked in one city."
    },
    {
      "start": 47.342,
      "end": 50.062,
      "zh": "夜里，*整座城亮起来*。",
      "en": "At night, the whole city lights up."
    },
    {
      "start": 50.162,
      "end": 53.014,
      "zh": "南京不吵，*但耐看*。",
      "en": "Nanjing is quiet, but it lasts."
    }
  ],
