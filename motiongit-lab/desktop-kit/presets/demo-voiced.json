  "captions": [
    {
      "start": 0.23,
      "end": 4.15,
      "zh": "我们把*一整台 Mac 桌面*，重写成了模板。",
      "en": "We rebuilt an entire Mac desktop as a template."
    },
    {
      "start": 4.25,
      "end": 9.466,
      "zh": "壁纸、菜单栏、Dock、*人物摄像头窗口*，全都在。",
      "en": "Wallpaper, menu bar, Dock and the camera window."
    },
    {
      "start": 9.566,
      "end": 14.206,
      "zh": "先看评论：大家最关心的其实是*出片速度*。",
      "en": "Most comments ask about rendering speed."
    },
    {
      "start": 14.306,
      "end": 18.394,
      "zh": "原来的模板很好看，但只发挥了*部分能力*。",
      "en": "The original was good, but only partly used."
    },
    {
      "start": 18.494,
      "end": 23.038,
      "zh": "现在是*一条命令*，不用浏览器，也不用等核心。",
      "en": "One command. No browser, no protected core."
    },
    {
      "start": 23.138,
      "end": 26.362,
      "zh": "所以结论很简单：*不用等*。",
      "en": "So the answer is simple: no waiting."
    },
    {
      "start": 26.462,
      "end": 29.974,
      "zh": "单帧两毫秒，*八路并行*同时画。",
      "en": "Two milliseconds per frame, eight workers."
    },
    {
      "start": 30.074,
      "end": 33.73,
      "zh": "同样一条片子，速度差了*四十五倍*。",
      "en": "Forty-five times faster for the same film."
    },
    {
      "start": 33.83,
      "end": 37.366,
      "zh": "排名翻牌，把旧流程*挤到第二行*。",
      "en": "The flip ranking pushes the old flow to row two."
    },
    {
      "start": 37.466,
      "end": 40.93,
      "zh": "但复刻不是复制，*边界要说清*。",
      "en": "Replication is not copying. State the limits."
    },
    {
      "start": 41.03,
      "end": 45.358,
      "zh": "换上你的文案、截图和配音，*车票就生效*。",
      "en": "Swap in your copy and voice, and the ticket works."
    },
    {
      "start": 45.458,
      "end": 49.306,
      "zh": "十六个镜头，都是同一套*组件*拼出来的。",
      "en": "Sixteen shots, all from the same components."
    },
    {
      "start": 49.406,
      "end": 53.662,
      "zh": "分镜表是 JSON，*改一行就能重渲*。",
      "en": "The storyboard is JSON; one line triggers a rerender."
    },
    {
      "start": 53.762,
      "end": 58.378,
      "zh": "渲染完成，回执里写着*帧数和校验结果*。",
      "en": "Render done, with frames and checks in the receipt."
    },
    {
      "start": 58.478,
      "end": 62.446,
      "zh": "文件散开，剩下的是*你自己的产线*。",
      "en": "Files fan out; what's left is your own pipeline."
    },
    {
      "start": 62.546,
      "end": 66.358,
      "zh": "桌面还是那张桌面，*主角换成你*。",
      "en": "Same desktop. This time, you are the presenter."
    }
