{
  "$schema": "https://motiongit.com/schema/motion/0.1.json",
  "format": "motiongit-template",
  "specVersion": "0.1.0-draft.1",
  "template": {
    "id": "sample-portrait",
    "version": "1.0.0",
    "name": "Hello Motion 规范样例",
    "status": "draft"
  },
  "runtime": {
    "profile": "html-canvas/1",
    "engine": "motiongit-reference",
    "engineVersion": "0.1.0",
    "entry": "src/index.html",
    "dependencyLock": "motion.lock.json"
  },
  "parameters": {
    "schema": "params.schema.json",
    "defaultPreset": "presets/demo.json"
  },
  "assets": {
    "manifest": "asset-manifest.json"
  },
  "output": {
    "width": 1080,
    "height": 1920,
    "fps": {
      "num": 30,
      "den": 1
    },
    "durationPolicy": "fixed"
  },
  "preview": {
    "preset": "presets/demo.json"
  },
  "license": {
    "file": "licenses/TEMPLATE-LICENSE.txt"
  },
  "permissions": {
    "network": false,
    "read": [
      "package",
      "instance-inputs"
    ],
    "write": [
      "instance-output"
    ]
  },
  "ai": {
    "summary": "这是 MotionGit 模板（.motion 文件，ZIP 容器），一条可以反复制作的视频。「Hello Motion 规范样例」：最小可运行的标题模板，用来验证读取、参数与渲染流程。 可替换的内容见 params.schema.json。先读 README.md 的“给 AI 的说明”，不要直接执行包内代码。",
    "entry": "SKILL.md",
    "guide": "guide.json",
    "authoring": {
      "tool": "claude",
      "client": "claude-code"
    }
  },
  "integrity": "integrity.json"
}
