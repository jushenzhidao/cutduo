# renderd 生产环境变量
#
#   cp .env.example .env      # 或直接跑 install.sh，它会随机生成密钥
#   chmod 600 .env            # 里面有令牌与数据库密码
#
# 带「必填」的项没有默认值，缺失时 compose 会直接报错退出（而不是悄悄用弱值）。

# ── 数据库 ─────────────────────────────────────────────
# 必填。生成：openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=renderd
POSTGRES_DB=renderd
POSTGRES_VERSION=16

# ── 服务 ───────────────────────────────────────────────
# 必填。租户令牌，格式 名称:租户，多个用逗号分隔。
#   生成：openssl rand -hex 32
#   多租户示例：RENDERD_TOKENS=a1b2c3...:acme,d4e5f6...:globex
RENDERD_TOKENS=

# 必填。签名密钥，32 字节十六进制。生成：openssl rand -hex 32
# 改了它 = 所有已发出的下载链接立即失效。
RENDERD_SECRET=

# 可选。管理令牌（逗号分隔），可访问 admin scope 的端点。
RENDERD_ADMIN_TOKENS=

# 可选。对外访问基址，用于回执里的绝对链接。
# 走 Caddy TLS 时填 https://render.example.com；留空则按请求 Host 推导。
RENDERD_PUBLIC_BASE_URL=

# 端口与监听地址。默认只绑回环，公网入口交给 Caddy。
RENDERD_PORT=8787
RENDERD_BIND=127.0.0.1

# 镜像名，配合私有仓库时改成 registry.cn-hangzhou.aliyuncs.com/xxx/renderd:0.1.0
RENDERD_IMAGE=renderd:0.1.0

# ── 容量与背压 ─────────────────────────────────────────
RENDERD_QUOTA_QPS=10
RENDERD_MAX_QUEUE_DEPTH=2000
RENDERD_MAX_TENANT_INFLIGHT=8
RENDERD_STORAGE_QUOTA_MB=2048
RENDERD_MAX_UPLOAD_MB=512

# 就绪探针的磁盘闸（GB）。低于此值 /readyz 返回 503，不再接新任务。
RENDERD_MIN_FREE_GB=5

# ── worker ────────────────────────────────────────────
RENDERD_WORKER_CONCURRENCY=1
RENDERD_WORKER_TENANT=acme
RENDERD_WORKER_NAME=w1

# ── 资源上限 ───────────────────────────────────────────
# 按机器规格调。渲染吃 CPU，8 核机器建议 worker 4-6、api 1-2。
API_CPUS=2.0
API_MEMORY=2g
WORKER_CPUS=4.0
WORKER_MEMORY=4g

# ── 回调 ───────────────────────────────────────────────
# 1 = 允许 webhook 回调私网地址。默认 0：云上开着它等于把 SSRF 打到元数据服务。
# 只有在「回调目标是同一 VPC 内的内网服务」时才打开，并确保该网段可信。
RENDERD_ALLOW_PRIVATE_CALLBACKS=0

# ── 可选：Caddy TLS（--profile tls 时必填 RENDERD_DOMAIN）──
RENDERD_DOMAIN=
ACME_EMAIL=
