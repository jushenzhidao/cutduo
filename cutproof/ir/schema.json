{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cutproof.local/ir/0.1/schema.json",
  "title": "Cutproof Timeline IR v0.1",
  "description": "引擎无关的时间线中间表示。事实来源是这份 JSON，不是任何引擎的执行格式。所有时间量为整数帧（不出现浮点秒），素材以内容哈希寻址。",
  "type": "object",
  "required": ["ir_version", "id", "output", "assets", "tracks"],
  "additionalProperties": false,
  "properties": {
    "ir_version": { "const": "0.1" },
    "id": { "type": "string", "pattern": "^[a-z0-9_]{3,64}$" },
    "title": { "type": "string" },
    "output": { "$ref": "#/$defs/output" },
    "styles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/style" }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/track" }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "egress": { "enum": ["platform", "customer_bucket"], "default": "platform" },
        "retention_hours": { "type": "integer", "minimum": 1, "default": 168 }
      }
    }
  },
  "$defs": {
    "output": {
      "type": "object",
      "required": ["width", "height", "fps", "duration_frames", "video", "audio", "color"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "height": { "type": "integer", "minimum": 16, "maximum": 4096 },
        "fps": { "$ref": "#/$defs/rational" },
        "duration_frames": { "type": "integer", "minimum": 1 },
        "video": {
          "type": "object",
          "required": ["codec", "bitrate_kbps", "pix_fmt"],
          "additionalProperties": false,
          "properties": {
            "codec": { "enum": ["h264", "hevc", "av1"] },
            "bitrate_kbps": { "type": "integer", "minimum": 200 },
            "pix_fmt": { "enum": ["yuv420p", "yuv422p10le", "yuv420p10le"] },
            "preset": { "type": "string", "default": "veryfast" },
            "gop_frames": { "type": "integer", "minimum": 1, "default": 60 }
          }
        },
        "audio": {
          "type": "object",
          "required": ["codec", "sample_rate", "channels"],
          "additionalProperties": false,
          "properties": {
            "codec": { "enum": ["aac", "opus"] },
            "sample_rate": { "enum": [44100, 48000] },
            "channels": { "enum": [1, 2] },
            "bitrate_kbps": { "type": "integer", "default": 192 },
            "target_lufs": { "type": "number", "default": -14.0 }
          }
        },
        "color": {
          "type": "object",
          "required": ["primaries", "transfer", "matrix", "range"],
          "additionalProperties": false,
          "properties": {
            "primaries": { "const": "bt709" },
            "transfer": { "const": "bt709" },
            "matrix": { "const": "bt709" },
            "range": { "const": "tv" }
          }
        }
      }
    },
    "rational": {
      "type": "object",
      "required": ["num", "den"],
      "additionalProperties": false,
      "properties": {
        "num": { "type": "integer", "minimum": 1 },
        "den": { "type": "integer", "minimum": 1 }
      }
    },
    "asset": {
      "type": "object",
      "required": ["id", "uri", "sha256"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "uri": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "kind": { "enum": ["video", "audio", "image"], "default": "video" },
        "probe": { "type": "object" }
      }
    },
    "track": {
      "type": "object",
      "required": ["id", "kind", "clips"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["video", "text", "audio", "overlay"] },
        "clips": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/clip" } }
      }
    },
    "clip": {
      "type": "object",
      "required": ["at_frame", "out_frame"],
      "additionalProperties": false,
      "properties": {
        "asset": { "type": "string", "description": "assets[].id；文本轨可省略" },
        "at_frame": { "type": "integer", "minimum": 0, "description": "时间线上的起点（整数帧，绝对）" },
        "out_frame": { "type": "integer", "minimum": 1 },
        "in_frame": { "type": "integer", "minimum": 0, "default": 0 },
        "text": { "type": "string" },
        "style": { "type": "string", "description": "引用 styles 的 key" },
        "fit": { "enum": ["cover", "contain", "stretch"], "default": "cover" },
        "speed": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
        "fade_in_frames": { "type": "integer", "minimum": 0, "default": 0 },
        "fade_out_frames": { "type": "integer", "minimum": 0, "default": 0 },
        "gain_db": { "type": "number", "default": 0 }
      }
    },
    "style": {
      "type": "object",
      "required": ["font_family", "font_size", "fill"],
      "additionalProperties": false,
      "properties": {
        "font_family": { "type": "string", "description": "必须是镜像内预装字体的精确 family 名；缺失视为硬失败" },
        "font_file": { "type": "string", "description": "显式字体文件路径，优先于 font_family" },
        "font_size": { "type": "integer", "minimum": 8 },
        "fill": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}(@[0-9.]+)?$" },
        "stroke": { "type": "string" },
        "align": { "enum": ["left", "center", "right"], "default": "center" },
        "anchor": { "enum": ["center", "bottom", "top"], "default": "center" },
        "offset_y": { "type": "number", "default": 0 },
        "max_chars_per_line": { "type": "integer" },
        "safe_area": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": { "type": "number" },
            "bottom": { "type": "number" },
            "left": { "type": "number" },
            "right": { "type": "number" }
          }
        }
      }
    }
  }
}
