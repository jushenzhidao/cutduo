  "captions": [
    { "start": 0.12, "end": 4.9, "zh": "今晚这顿，*锅先开*。", "en": "The pot comes first tonight." },
    { "start": 5.12, "end": 8.9, "zh": "事情稍后再说，*先坐下*。", "en": "Everything else can wait." },
    { "start": 9.12, "end": 13.9, "zh": "蒸汽一起，*筷子就到了*。", "en": "Steam rises, chopsticks arrive." },
    { "start": 14.12, "end": 18.9, "zh": "桌上摆得满满的，*不急*。", "en": "The table is full. No rush." },
    { "start": 19.12, "end": 22.9, "zh": "菜先摆好，*汤还在滚*。", "en": "Dishes out, broth still boiling." },
    { "start": 23.12, "end": 26.9, "zh": "锅一直没停，*也没人催*。", "en": "The pot keeps going; nobody hurries." },
    { "start": 27.12, "end": 30.9, "zh": "一筷一筷，*慢慢来*。", "en": "One bite at a time." },
    { "start": 31.12, "end": 34.9, "zh": "人多一点，*菜就多一点*。", "en": "More people, more dishes." },
    { "start": 35.12, "end": 38.9, "zh": "热气糊了镜头，*正好*。", "en": "Steam fogs the lens. Good." },
    { "start": 39.12, "end": 42.9, "zh": "砂锅里，*还在滚*。", "en": "Still bubbling in the pot." },
    { "start": 43.12, "end": 47.9, "zh": "不赶时间，*是这顿的规矩*。", "en": "No rush is the rule tonight." },
    { "start": 48.12, "end": 51.9, "zh": "汤剩一点，*话还没说完*。", "en": "Soup's nearly gone; talking isn't." },
    { "start": 52.12, "end": 56.9, "zh": "下次还来，*锅要滚，人要齐*。", "en": "Next time: same pot, same people." }
  ]
