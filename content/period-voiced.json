    {
      "start": 0.23,
      "end": 2.974,
      "zh": "大姨妈来了，*先别慌*。",
      "en": "Your period is here. Don't panic."
    },
    {
      "start": 3.074,
      "end": 6.226,
      "zh": "不适通常 *两三天内缓解*。",
      "en": "It usually eases in a few days."
    },
    {
      "start": 6.326,
      "end": 10.39,
      "zh": "热敷、止痛药、休息，*按顺序来*。",
      "en": "Heat, pain relief, then rest."
    },
    {
      "start": 10.49,
      "end": 13.57,
      "zh": "热敷之外，*也别忘了休息*。",
      "en": "Rest matters just as much."
    },
    {
      "start": 13.67,
      "end": 16.846,
      "zh": "布洛芬这类药，*是一线方案*。",
      "en": "NSAIDs are the first-line option."
    },
    {
      "start": 16.946,
      "end": 20.17,
      "zh": "痛刚起来就吃，*比硬忍有效*。",
      "en": "Take it at the first sign of pain."
    },
    {
      "start": 20.27,
      "end": 23.854,
      "zh": "红糖水、姜茶，*目前没有证据*。",
      "en": "Brown sugar and ginger tea lack evidence."
    },
    {
      "start": 23.954,
      "end": 27.106,
      "zh": "痛到影响生活，*不用硬扛*。",
      "en": "You do not have to tough it out."
    },
    {
      "start": 27.206,
      "end": 30.334,
      "zh": "但这几种情况，*别在家扛*。",
      "en": "But some signs need a doctor."
