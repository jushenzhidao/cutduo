  "captions": [
    {
      "start": 0.23,
      "end": 3.286,
      "zh": "剪辑最贵的地方，*不是剪*。",
      "en": "Editing is not the expensive part."
    },
    {
      "start": 3.386,
      "end": 7.162,
      "zh": "是等渲染、找素材、*对时间轴*。",
      "en": "It is waiting, searching, syncing."
    },
    {
      "start": 7.262,
      "end": 10.51,
      "zh": "真正在剪的时间，*不到两成*。",
      "en": "Less than 20% is actually editing."
    },
    {
      "start": 10.61,
      "end": 14.506,
      "zh": "转写、检索、粗剪，*一条命令*。",
      "en": "Transcribe, search, rough-cut."
    },
    {
      "start": 14.606,
      "end": 18.574,
      "zh": "一条 46 秒的片子，*3.2 秒*出片。",
      "en": "A 46s film renders in 3.2s."
    },
    {
      "start": 18.674,
      "end": 21.97,
      "zh": "同样的活，*时间砍到五分之一*。",
      "en": "Same work, one fifth the time."
    },
    {
      "start": 22.07,
      "end": 25.462,
      "zh": "最耗时的两件事，*都能交出去*。",
      "en": "The two slowest steps can go."
    },
    {
      "start": 25.562,
      "end": 28.21,
      "zh": "能接的活，*列得出来*。",
      "en": "The list is concrete."
    },
    {
      "start": 28.31,
      "end": 31.246,
      "zh": "但它有三件事，*做不了*。",
      "en": "But three things it cannot do."
    },
    {
      "start": 31.346,
      "end": 34.282,
      "zh": "观点和节奏，*只能你来*。",
      "en": "Taste and pacing stay with you."
    },
    {
      "start": 34.382,
      "end": 38.326,
      "zh": "素材、字幕、成片，*一处归档*。",
      "en": "Everything lands in one place."
    },
    {
      "start": 38.426,
      "end": 41.566,
      "zh": "AI 干搬砖，*你干决定*。",
      "en": "AI moves bricks. You decide."
