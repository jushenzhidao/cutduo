    {
      "start": 0.12,
      "end": 4.9,
      "zh": "大姨妈来了，*先别慌*。",
      "en": "Your period is here. Don't panic."
    },
    {
      "start": 5.12,
      "end": 8.9,
      "zh": "不适通常 *两三天内缓解*。",
      "en": "It usually eases in a few days."
    },
    {
      "start": 9.12,
      "end": 14.9,
      "zh": "热敷、止痛药、休息，*按顺序来*。",
      "en": "Heat, pain relief, then rest."
    },
    {
      "start": 15.12,
      "end": 18.9,
      "zh": "热敷之外，*也别忘了休息*。",
      "en": "Rest matters just as much."
    },
    {
      "start": 19.12,
      "end": 22.9,
      "zh": "布洛芬这类药，*是一线方案*。",
      "en": "NSAIDs are the first-line option."
    },
    {
      "start": 23.12,
      "end": 26.9,
      "zh": "痛刚起来就吃，*比硬忍有效*。",
      "en": "Take it at the first sign of pain."
    },
    {
      "start": 27.12,
      "end": 31.9,
      "zh": "红糖水、姜茶，*目前没有证据*。",
      "en": "Brown sugar and ginger tea lack evidence."
    },
    {
      "start": 32.12,
      "end": 35.9,
      "zh": "痛到影响生活，*不用硬扛*。",
      "en": "You do not have to tough it out."
    },
    {
      "start": 36.12,
      "end": 39.9,
      "zh": "但这几种情况，*别在家扛*。",
      "en": "But some signs need a doctor."
    },
    {
      "start": 40.12,
      "end": 44.9,
      "zh": "每小时湿透一片，*连续两小时*。",
      "en": "Soaking a pad hourly, for two hours."
    },
    {
      "start": 45.12,
      "end": 49.9,
      "zh": "超过七天、大血块、*晕厥*，都去查。",
      "en": "Over 7 days, large clots, fainting."
    },
    {
      "start": 50.12,
      "end": 53.9,
      "zh": "记下日期和量，*下次好判断*。",
      "en": "Log the dates and the flow."
