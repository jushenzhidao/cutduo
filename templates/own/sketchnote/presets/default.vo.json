  "captions": [
    {
      "start": 0.45,
      "end": 3.494,
      "text": "先看现象，把看到的记下来"
    },
    {
      "start": 3.634,
      "end": 6.27,
      "text": "同一份样品，才能对比"
    },
    {
      "start": 7.13,
      "end": 10.246,
      "text": "一个关键词，串起整页笔记"
    },
    {
      "start": 10.386,
      "end": 13.19,
      "text": "它指的不是结论，是依据"
    },
    {
      "start": 14.05,
      "end": 17.142,
      "text": "便签上改一版，旧的那条划掉"
    },
    {
      "start": 17.282,
      "end": 19.942,
      "text": "改的是条件，不是结论"
    },
    {
      "start": 20.802,
      "end": 23.966,
      "text": "回看原来的解释，才算闭环"
    }
  ],
