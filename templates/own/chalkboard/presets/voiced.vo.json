  "captions": [
    {
      "text": "同一块遮光片，挡住多少不由距离决定",
      "start": 0.45,
      "end": 4.43,
      "speaker": "default"
    },
    {
      "text": "而是两个圆面真正相交的面积",
      "start": 4.57,
      "end": 7.83,
      "speaker": "default"
    },
    {
      "text": "七条光线从光源射向球面",
      "start": 8.69,
      "end": 11.782,
      "speaker": "default"
    },
    {
      "text": "每条只停在遇到的第一块挡板",
      "start": 11.922,
      "end": 14.894,
      "speaker": "default"
    },
    {
      "text": "轨道有高度，俯视看排成一条线",
      "start": 15.754,
      "end": 19.182,
      "speaker": "default"
    },
    {
      "text": "却可能整条从影子上面过去",
      "start": 19.322,
      "end": 22.342,
      "speaker": "default"
    },
    {
      "text": "对向、影高、圆面重叠，三个条件",
      "start": 23.202,
      "end": 27.158,
      "speaker": "default"
    },
    {
      "text": "同时成立，才叫真正挡住",
      "start": 27.298,
      "end": 30.222,
      "speaker": "default"
    }
  ],
