  "captions": [
    {
      "seg": 0,
      "text": "同一块遮光片，挡住多少不由距离决定",
      "start": 0.4,
      "end": 4.5,
      "speaker": "default"
    },
    {
      "seg": 0,
      "text": "而是两个圆面真正相交的面积",
      "start": 4.55,
      "end": 8.7,
      "speaker": "default"
    },
    {
      "seg": 1,
      "text": "七条光线从光源射向球面",
      "start": 9.4,
      "end": 13.0,
      "speaker": "default"
    },
    {
      "seg": 1,
      "text": "每条只停在遇到的第一块挡板",
      "start": 13.05,
      "end": 16.7,
      "speaker": "default"
    },
    {
      "seg": 2,
      "text": "轨道有高度，俯视看排成一条线",
      "start": 17.4,
      "end": 21.5,
      "speaker": "default"
    },
    {
      "seg": 2,
      "text": "却可能整条从影子上面过去",
      "start": 21.55,
      "end": 25.7,
      "speaker": "default"
    },
    {
      "seg": 3,
      "text": "对向、影高、圆面重叠，三个条件",
      "start": 26.4,
      "end": 30.0,
      "speaker": "default"
    },
    {
      "seg": 3,
      "text": "同时成立，才叫真正挡住",
      "start": 30.05,
      "end": 33.7,
      "speaker": "default"
    }
  ]
