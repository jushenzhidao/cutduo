{
  "$schema": "https://motiongit.com/schema/motion/0.1.json",
  "format": "motiongit-template",
  "specVersion": "0.1.0-draft.1",
  "template": {
    "id": "night-card",
    "version": "0.1.0",
    "name": "夜色卡片",
    "status": "draft",
    "distilledFrom": {
      "source": "self-built",
      "durationSeconds": 56,
      "resolution": "1080x1920",
      "fps": 30,
      "shots": 8,
      "medianShotSeconds": 7,
      "note": "原创版式，未复制任何第三方素材、文案或品牌标识；节奏参数来自本模板 8 段示例的实测"
    }
  },
  "runtime": {
    "profile": "html-canvas/1",
    "engine": "motiongit-reference",
    "entry": "src/index.html",
    "dependencyLock": "motion.lock.json"
  },
  "parameters": {
    "schema": "params.schema.json",
    "defaultPreset": "presets/default.json"
  },
  "assets": {
    "manifest": "asset-manifest.json"
  },
  "output": {
    "width": 1080,
    "height": 1920,
    "fps": {
      "num": 30,
      "den": 1
    },
    "durationPolicy": "fixed",
    "durationSeconds": 56
  },
  "preview": {
    "preset": "presets/default.json"
  },
  "license": {
    "file": "licenses/TEMPLATE-LICENSE.txt"
  },
  "permissions": {
    "network": false,
    "read": [
      "package",
      "instance-inputs"
    ],
    "write": [
      "instance-output"
    ]
  },
  "ai": {
    "entry": "SKILL.md",
    "guide": "guide.json",
    "summary": "竖屏情绪向卡片：一屏一句话，深色底加暖金点缀"
  },
  "integrity": "integrity.json"
}
