{
  "schema": "cutduo-calibration/1",
  "kit": "science",
  "purpose": "跨片可复用的标定值：画幅、调色板、字幕样式、各版式的元素锚点。agent 读这一个文件就能取默认值并做断言，不必去翻 elements.json 里那条片专有的记录。",
  "readingGuide": {
    "scope": {
      "any-film": "所有片通用，直接当默认值用",
      "appearance": "绑定某一代外观，取用前先看 appliesTo.profile 与 params.profile 是否一致",
      "instance": "只属于参考片，不写在本文件；见 out/replica-science-vo/elements.json"
    },
    "appliesTo.profile": "* = 任意外观代；具体名字 = 仅该 profile 成立（见 guide.json → profiles）",
    "verify.method": "已实现的断言方法：image.* 看渲染结果，param.* 读 params，ink.*/mask.* 走掩膜，null = 只供人参考、机器不判",
    "units": "px = 1080p 像素；frac = 以画幅宽(W)或高(H)归一化"
  },
  "measuredFrom": {
    "file": "science-explainer-demo-vo.mp4（用户提供的 568×320 转存版）",
    "size": "568x320",
    "fps": 30,
    "frames": 2215,
    "profile": "legacy-2026-11",
    "precision": "±3px@568 ≈ ±0.005W / ±0.009H；因此容差取 0.008–0.02",
    "note": "锚点全部来自成片抽帧实测（tools/text-bands.mjs / replica-compare.mjs 的掩膜法），不是从代码里抄的默认值。"
  },
