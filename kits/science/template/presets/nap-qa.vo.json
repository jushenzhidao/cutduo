  "captions": [
    {
      "speaker": "default",
      "start": 0.45,
      "end": 2.894,
      "text": "为什么中午非要睡一觉"
    },
    {
      "speaker": "mom",
      "start": 3.034,
      "end": 5.91,
      "text": "不是偷懒，是大脑在清账"
    },
    {
      "speaker": "kid",
      "start": 6.77,
      "end": 9.55,
      "text": "妈妈，我一点都不困"
    },
    {
      "speaker": "kid",
      "start": 9.69,
      "end": 12.014,
      "text": "为什么非要躺下"
    },
    {
      "speaker": "mom",
      "start": 12.874,
      "end": 16.686,
      "text": "困不困，和身体需要不需要是两件事"
    },
    {
      "speaker": "mom",
      "start": 16.826,
      "end": 19.87,
      "text": "上午学的东西，都堆在脑子里"
    },
    {
      "speaker": "mom",
      "start": 20.73,
      "end": 23.654,
      "text": "睡着以后，大脑开始整理"
    },
    {
      "speaker": "mom",
      "start": 23.794,
      "end": 26.91,
      "text": "把重要的存起来，把没用的丢掉"
    },
    {
      "speaker": "mom",
      "start": 27.77,
      "end": 31.15,
      "text": "所以午睡后回想东西会更清楚"
    },
    {
      "speaker": "mom",
      "start": 31.29,
      "end": 34.334,
      "text": "情绪也更稳，不容易一点就炸"
    },
    {
      "speaker": "mom",
      "start": 34.474,
      "end": 37.11,
      "text": "下午上课也更坐得住"
    },
    {
      "speaker": "mom",
      "start": 37.97,
      "end": 40.27,
      "text": "关键不在于睡多久"
    },
    {
      "speaker": "mom",
      "start": 40.41,
      "end": 43.43,
      "text": "二十分钟，比一小时更管用"
    },
    {
      "speaker": "mom",
      "start": 44.29,
      "end": 46.926,
      "text": "三条提醒，记住就行"
    },
    {
      "speaker": "mom",
      "start": 47.066,
      "end": 50.374,
      "text": "别超过半小时，否则越睡越昏"
    },
    {
      "speaker": "mom",
      "start": 50.514,
      "end": 53.486,
      "text": "别趴桌上，压着眼睛和胃"
    },
    {
      "speaker": "mom",
      "start": 54.346,
      "end": 57.006,
      "text": "睡一会儿，是给下午充电"
    }
  ],
