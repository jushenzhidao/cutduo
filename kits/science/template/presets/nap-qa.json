  "captions": [
    {
      "seg": 0,
      "speaker": "default",
      "start": 0,
      "end": 0,
      "text": "为什么中午非要睡一觉"
    },
    {
      "seg": 0,
      "speaker": "mom",
      "start": 0,
      "end": 0,
      "text": "不是偷懒，是大脑在清账"
    },
    {
      "seg": 1,
      "speaker": "kid",
      "start": 0,
      "end": 0,
      "text": "妈妈，我一点都不困"
    },
    {
      "seg": 1,
      "speaker": "kid",
      "start": 0,
      "end": 0,
      "text": "为什么非要躺下"
    },
    {
      "seg": 2,
      "speaker": "mom",
      "start": 0,
      "end": 0,
      "text": "困不困，和身体需要不需要是两件事"
    },
    {
      "seg": 2,
      "speaker": "mom",
      "start": 0,
      "end": 0,
      "text": "上午学的东西，都堆在脑子里"
    },
    {
      "seg": 3,
      "speaker": "mom",
      "start": 0,
      "end": 0,
      "text": "睡着以后，大脑开始整理"
    },
    {
      "seg": 3,
      "speaker": "mom",
      "start": 0,
      "end": 0,
      "text": "把重要的存起来，把没用的丢掉"
    },
    {
      "seg": 4,
      "speaker": "mom",
      "start": 0,
      "end": 0,
      "text": "所以午睡后回想东西会更清楚"
    },
    {
      "seg": 4,
      "speaker": "mom",
      "start": 0,
      "end": 0,
      "text": "情绪也更稳，不容易一点就炸"
    },
    {
      "seg": 4,
      "speaker": "mom",
      "start": 0,
      "end": 0,
      "text": "下午上课也更坐得住"
    },
    {
      "seg": 5,
      "speaker": "mom",
      "start": 0,
      "end": 0,
      "text": "关键不在于睡多久"
    },
    {
      "seg": 5,
      "speaker": "mom",
      "start": 0,
      "end": 0,
      "text": "二十分钟，比一小时更管用"
    },
    {
      "seg": 6,
      "speaker": "mom",
      "start": 0,
      "end": 0,
      "text": "三条提醒，记住就行"
    },
    {
      "seg": 6,
      "speaker": "mom",
      "start": 0,
      "end": 0,
      "text": "别超过半小时，否则越睡越昏"
    },
    {
      "seg": 6,
      "speaker": "mom",
      "start": 0,
      "end": 0,
      "text": "别趴桌上，压着眼睛和胃"
    },
    {
      "seg": 7,
      "speaker": "mom",
      "start": 0,
      "end": 0,
      "text": "睡一会儿，是给下午充电"
    }
  ],
