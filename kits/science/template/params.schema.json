{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "science-explainer params",
  "type": "object",
  "required": [
    "segments"
  ],
  "additionalProperties": false,
  "properties": {
    "durationSeconds": {
      "type": "number",
      "minimum": 4,
      "maximum": 600,
      "description": "成片总时长（秒）；必须等于 segments 的 dur 累加，否则末段被截断"
    },
    "fps": {
      "type": "number",
      "minimum": 12,
      "maximum": 60
    },
    "fadeOutSeconds": {
      "type": "number",
      "minimum": 0,
      "maximum": 3
    },
    "theme": {
      "type": "object",
      "description": "强调色。缺省继承内置色板；只改这里即可换品牌色，无需改源码",
      "properties": {
        "pop": {
          "type": "string",
          "description": "强调红（爆炸贴/病灶/划除线）"
        },
        "sun": {
          "type": "string",
          "description": "标签黄（荧光笔/圆卡底）"
        },
        "jade": {
          "type": "string",
          "description": "主青绿（标题条/勾选）"
        },
        "jadeDeep": {
          "type": "string",
          "description": "深青绿（标题条底）"
        },
        "blue": {
          "type": "string",
          "description": "辅助蓝（斜切标签/时钟）"
        },
        "ink": {
          "type": "string",
          "description": "正文墨色"
        }
      }
    },
    "brand": {
      "type": "object",
      "description": "左下角角标。show=false 或整段省略则不画",
      "properties": {
        "show": {
          "type": "boolean"
        },
        "text": {
          "type": "string",
          "maxLength": 16
        },
        "tag": {
          "type": "string",
          "maxLength": 28
        }
      }
    },
    "subtitle": {
      "type": "object",
      "description": "烧录字幕样式。参考片实测：白字 + 粗深色描边，居中，底部安全区",
      "properties": {
        "size": {
          "type": "number",
          "minimum": 32,
          "maximum": 96
        },
        "color": {
          "type": "string"
        },
        "stroke": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "strokeColor": {
          "type": "string"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "captions": {
      "type": "array",
      "description": "口播字幕时间轴；间隔留 0.1s 以上，避免相邻两条同时出现在画面",
      "items": {
        "type": "object",
        "required": [
          "start",
          "end",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "maxLength": 40
          },
          "speaker": {
            "type": "string",
            "maxLength": 12,
            "description": "说话人标识，对应 voices 的键；缺省用 default"
          },
          "seg": {
            "type": "integer",
            "minimum": 0,
            "description": "归属第几段（0 起）。留空则按 start 落在哪一段推断；显式指定更可靠，vo.py 优先用它"
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "description": "镜头序列，按数组顺序硬切；中位 2.75s/镜（参考片实测），信息型镜头 5–8s、讲解位 4–6s",
      "items": {
        "type": "object",
        "required": [
          "type",
          "dur"
        ],
        "properties": {
          "type": {
            "enum": [
              "cover",
              "talk",
              "diagram",
              "compare",
              "matrix",
              "focus",
              "tip",
              "outro"
            ],
            "description": "版式：cover 封面 / talk 讲解位 / diagram 圆框图解 / compare 对比 / matrix 图标阵列 / focus 单卡强调 / tip 便签 / outro 结尾"
          },
          "dur": {
            "type": "number",
            "minimum": 1,
            "maximum": 30
          },
          "note": {
            "type": "string",
            "description": "给编辑看的备注，不参与渲染"
          },
          "args": {
            "type": "object",
            "additionalProperties": false,
            "description": "版式参数，逐版式见 guide.json 的 layouts 字段",
            "properties": {
              "accentLine": {
                "description": "哪一行用红字 + 荧光笔，默认 0",
                "type": "number"
              },
              "burstR": {
                "description": "爆炸贴半径，默认 384",
                "type": "number"
              },
              "callouts": {
                "description": "[{text, at, x, y, size, lead:[x,y], underline, markColor}]，lead 用画布归一化坐标指向病灶",
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "claim": {
                "description": "底部手写感结论，如「十几分钟出结果」",
                "type": "string"
              },
              "coat": {
                "description": "外套色，双人对白时用颜色区分角色"
              },
              "conclusion": {
                "description": "底部金句标签，留空则不画",
                "type": "string"
              },
              "cx": {
                "description": "圆心 x 归一化，默认 0.48"
              },
              "cy": {
                "description": "圆心 y 归一化，默认 0.505"
              },
              "eyebrow": {
                "description": "小眉标，如「家长最常见的困惑」",
                "type": "string"
              },
              "eyebrowColor": {
                "description": "眉标竖条颜色，用来区分角色（孩子蓝 / 妈妈绿）",
                "type": "string"
              },
              "eyes": {
                "description": "器官是否拟人化加眼睛，默认 true",
                "type": "boolean"
              },
              "figure": {
                "description": "right（默认）| left | none（不画人，纯字卡）",
                "type": "string"
              },
              "figureHeight": {
                "description": "人物高度占画面比。矢量人物 0.86 合适；**3D 姿态图建议 0.92–0.96**（0.86 时头顶距上沿约 0.22H，偏沉）",
                "type": "number"
              },
              "figureImage": {
                "description": "可选，透明底 PNG 的 data URL；缺省画内置扁平讲解员"
              },
              "figures": {
                "description": "false 时回退内置矢量人物；缺省用 assets/figures 的 3D 姿态图",
                "type": "boolean"
              },
              "gesture": {
                "description": "idle | explain（单手比划）| open（双手摊开）| point | count | nod（点头）",
                "type": "string"
              },
              "gestureAt": {
                "description": "手势起始秒（段内），默认 0.9"
              },
              "hair": {
                "description": "发色"
              },
              "head": {
                "description": "小眉标，默认「知识小贴士」",
                "type": "string"
              },
              "hint": {
                "description": "底部小字，可留空",
                "type": "string"
              },
              "icon": {
                "description": "圆卡内的图标",
                "type": "string"
              },
              "iconImage": {
                "description": "3D 道具名，优先于 icon",
                "type": "string"
              },
              "itemAt": {
                "description": "每一项的出现时间（段内秒）数组，与 items 一一对应；缺省按 0.02 + i×0.15 均分。由 tools/vo.py 按配音自动填，一般不必手写",
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "items": {
                "description": "[{image, icon, label, disc, stone, strike}]，image 优先（3D 道具），icon 是矢量回退（实测多类型，未收紧）",
                "type": "array"
              },
              "label": {
                "description": "可选标签 {text, at, x, y, size}"
              },
              "left": {
                "description": "{image, icon, label, note, bad, badge}",
                "type": "object"
              },
              "line1": {
                "description": "斜切条一，如「感谢观看」",
                "type": "string"
              },
              "line2": {
                "description": "斜切条二，如「下期再会」",
                "type": "string"
              },
              "lines": {
                "description": "主句数组，1–3 行，每行 ≤ 9 字",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "mark": {
                "description": "[x,y] 归一化病灶坐标，配合 pulse 呼吸闪烁",
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "note": {
                "description": "底部免责声明/引导语；此处不要再放同义字幕",
                "type": "string"
              },
              "organ": {
                "description": "gut / stomach / gallbladder / appendix / kidney / uterus / intussusception / scanner / probe / child",
                "type": "string"
              },
              "organImage": {
                "description": "用 assets/props 里的 3D 软胶道具名（gut/drop/clock/shield/check/radiation）；给了就画图，否则回退矢量器官",
                "type": "string"
              },
              "organSize": {
                "description": "器官图标直径（像素）；缺省按容器半径 ×1.62 推算",
                "type": "number"
              },
              "paper": {
                "description": "cream（默认）| mint | sky",
                "type": "string"
              },
              "prefix": {
                "description": "爆炸贴左侧的前缀词，白字蓝边，如「急诊室里的」",
                "type": "string"
              },
              "prefixSize": {
                "description": "前缀字号（像素），默认 116；前缀是压在爆炸贴左侧的小字",
                "type": "number"
              },
              "probe": {
                "description": "left | right | none，探头会朝圆心发声波",
                "type": "string"
              },
              "pulse": {
                "description": "布尔；为 true 时给病灶/标记加脉冲强调动画",
                "type": "boolean"
              },
              "r": {
                "description": "圆半径，默认 352"
              },
              "right": {
                "description": "{image, icon, label, note, badge}",
                "type": "object"
              },
              "scene": {
                "description": "soft（默认，柔光色块）| hallway（抽象医院走廊，注意会显得空）"
              },
              "size": {
                "description": "主句字号（像素），默认 86；行数多时调小，不要低于 64",
                "type": "number"
              },
              "skin": {
                "description": "肤色"
              },
              "sticker": {
                "description": "内置贴纸：eyes / question / star / drop",
                "type": "string"
              },
              "strike": {
                "description": "可选，左侧被划掉的旧认知标签，如「要等半天」",
                "type": "string"
              },
              "sub": {
                "description": "副标，黄底蓝斜边标签，一句话说清主题",
                "type": "string"
              },
              "talking": {
                "description": "[[起,止],...] 说话区间，嘴型只在区间内开合；由 tools/vo.py 自动写入，不必手填",
                "items": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              "title": {
                "description": "爆炸贴内的主词，4–6 字最佳，如「火眼金睛」",
                "type": "string"
              },
              "titleSize": {
                "description": "主词字号，默认 148",
                "type": "number"
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "string",
      "description": "配音音轨路径（由 tools/vo.py 生成）。仅作记录，渲染时仍需 --audio 显式传入"
    },
    "voices": {
      "type": "object",
      "description": "按角色映射 TTS 音色，如 {kid: zh-CN-YunxiaNeural, mom: zh-CN-XiaoxiaoNeural, default: ...}；captions[].speaker 指向这里的键",
      "additionalProperties": {
        "type": "string"
      }
    },
    "mouthCurve": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "description": "逐帧口型包络（0..1），由 tools/vo.py 从配音音轨算 RMS 生成；有它时人物嘴型按帧开合，忽略 talking 的模拟值"
    }
  }
}
