{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "desktop-kit params",
 "description": "Mac Desktop 复刻模板的分镜参数。时间单位一律秒（浮点），帧由 fps 换算。",
 "type": "object",
 "required": [
  "fps",
  "durationSeconds",
  "shots"
 ],
 "properties": {
  "fps": {
   "type": "integer",
   "enum": [
    24,
    30,
    60
   ],
   "default": 60
  },
  "durationSeconds": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "brand": {
   "type": "string",
   "description": "右下角常驻角标，留空不画"
  },
  "chapters": {
   "type": "array",
   "description": "章节顺序决定菜单栏路线图节点、壁纸与整屏翻牌转场",
   "items": {
    "type": "object",
    "required": [
     "name"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "wall": {
      "type": "string",
      "enum": [
       "blue",
       "light",
       "orange",
       "red"
      ],
      "default": "blue"
     }
    }
   }
  },
  "shots": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "type",
     "t0",
     "t1"
    ],
    "properties": {
     "type": {
      "type": "string",
      "enum": [
       "title",
       "talk",
       "flipBoard",
       "comments",
       "rating",
       "terminal",
       "counter",
       "station",
       "notify",
       "chart",
       "tickets",
       "ranking",
       "chat",
       "files",
       "checklist",
       "outro",
       "photo",
       "clip"
      ]
     },
     "t0": {
      "type": "number",
      "minimum": 0
     },
     "t1": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "chapter": {
      "type": "string",
      "description": "必须能在 chapters 里找到；章节切换触发整屏翻牌转场"
     },
     "args": {
      "type": "object",
      "description": "按镜头类型解释；见 README 的镜头参数表"
     }
    }
   }
  },
  "captions": {
   "type": "array",
   "description": "双语逐字字幕。zh 里用 *词* 标记黄色强调。",
   "items": {
    "type": "object",
    "required": [
     "start",
     "end",
     "zh"
    ],
    "properties": {
     "start": {
      "type": "number",
      "minimum": 0
     },
     "end": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "zh": {
      "type": "string"
     },
     "en": {
      "type": "string"
     }
    }
   }
  }
 }
}