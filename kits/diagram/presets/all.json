    {
      "family": "hierarchy",
      "duration": 6,
      "title": "资料与子类别",
      "items": [
        {
          "id": "all",
          "label": "资料"
        },
        {
          "id": "notes",
          "label": "文字记录",
          "parent": "all"
        },
        {
          "id": "tables",
          "label": "数据表",
          "parent": "all"
        },
        {
          "id": "interview",
          "label": "访谈记录",
          "parent": "notes"
        }
      ]
    },
    {
      "family": "cycle",
      "duration": 7,
      "title": "首尾相接的三步",
      "items": [
        {
          "id": "submit",
          "label": "提交",
          "text": "交出当前版本"
        },
        {
          "id": "feedback",
          "label": "反馈",
          "text": "获得具体意见"
        },
        {
          "id": "adjust",
          "label": "调整",
          "text": "形成下一版本"
        }
      ]
    },
    {
      "family": "definition",
      "duration": 6,
      "title": "两个容易混的概念",
      "items": [
        {
          "id": "latency",
          "label": "延迟",
          "text": "一次请求从发出到拿到结果的总时间，包含排队、传输和处理。"
        },
        {
          "id": "throughput",
          "label": "吞吐",
          "text": "单位时间内能处理完多少请求，跟单次快慢不是一回事。"
        }
      ]
    },
    {
      "family": "compare",
      "duration": 6,
      "title": "改版前后的两项指标",
      "beforeLabel": "改版前",
      "afterLabel": "改版后",
      "items": [
        {
          "id": "load",
          "label": "首屏加载",
          "before": "2.4 秒",
          "after": "0.9 秒"
        },
        {
          "id": "mem",
          "label": "常驻内存",
          "before": "820 MB",
          "after": "560 MB"
        }
      ]
    },
    {
      "family": "process",
      "duration": 7,
      "title": "一次改动的四个环节",
      "items": [
        {
          "id": "draft",
          "label": "起稿",
          "text": "先定结构"
        },
        {
          "id": "review",
          "label": "评审",
          "text": "挑出硬伤"
        },
        {
          "id": "revise",
          "label": "修改",
          "text": "只改关节点"
        },
        {
          "id": "ship",
          "label": "交付",
          "text": "跑完门禁"
        }
      ]
    },
    {
      "family": "causal",
      "duration": 7,
      "title": "一个直接原因和两个结果",
      "items": [
        {
          "id": "stale",
          "label": "缓存没失效"
        },
        {
          "id": "slow",
          "label": "首屏变慢"
        },
        {
          "id": "retry",
          "label": "重试变多"
        }
      ],
      "links": [
        {
          "from": "stale",
          "to": "slow"
        },
        {
          "from": "stale",
          "to": "retry"
        }
      ]
    },
    {
      "family": "parts",
      "duration": 6,
