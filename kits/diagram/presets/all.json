          "id": "a",
          "label": "样本 A",
          "value": 20,
          "unit": "个"
        },
        {
          "id": "b",
          "label": "样本 B",
          "value": 35,
          "unit": "个"
        },
        {
          "id": "c",
          "label": "样本 C",
          "value": 50,
          "unit": "个"
        },
        {
          "id": "d",
          "label": "样本 D",
          "value": 15,
          "unit": "个"
        }
      ]
    },
    {
