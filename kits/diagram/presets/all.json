      "items": [
        {
          "id": "net",
          "label": "网络",
          "value": 420,
          "unit": "ms"
        },
        {
          "id": "parse",
          "label": "解析",
          "value": 180,
          "unit": "ms"
        },
        {
          "id": "exec",
          "label": "执行",
          "value": 260,
          "unit": "ms"
        },
        {
          "id": "paint",
          "label": "绘制",
          "value": 140,
          "unit": "ms"
        }
      ]
    },
    {
      "family": "experiment",
      "duration": 6,
      "title": "同一段代码的两种条件",
      "items": [
        {
          "id": "c1",
          "condition": "关闭缓存",
          "result": "每次都要重新算一遍，平均 1.8 秒"
        },
        {
          "id": "c2",
          "condition": "开启缓存",
          "result": "命中后直接返回，平均 0.3 秒"
        }
      ]
    },
    {
      "family": "evidence",
      "duration": 6,
      "title": "一句原文",
      "items": [
        {
          "id": "q1",
          "text": "所有模型都是错的，但有些是有用的。",
          "source": "统计学家 George Box，1976"
        }
      ]
    },
    {
      "family": "formula",
      "duration": 7,
      "title": "把总时长拆开",
