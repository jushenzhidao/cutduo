      "items": [
        {
          "id": "T",
          "symbol": "T",
          "meaning": "总耗时",
          "value": "2.1 s"
        },
        {
          "id": "a",
          "symbol": "a",
          "meaning": "固定开销",
          "value": "0.4 s"
        },
        {
          "id": "b",
          "symbol": "b",
          "meaning": "单次增量",
          "value": "0.17 s"
        },
        {
          "id": "n",
          "symbol": "n",
          "meaning": "请求次数",
          "value": "10"
        }
      ]
    },
    {
      "family": "recap",
      "duration": 7,
      "title": "三句话收住",
      "items": [
        {
          "id": "r1",
          "label": "先量再改",
          "text": "没有数字的优化只是换了一种写法。"
        },
        {
          "id": "r2",
          "label": "瓶颈只有一个",
          "text": "同时改三处，等于不知道是哪处起效。"
        },
        {
          "id": "r3",
          "label": "留一条退路",
          "text": "能回滚，才敢动关节点。"
        }
      ]
