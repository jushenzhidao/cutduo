{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "diagram kit · params",
  "type": "object",
  "additionalProperties": true,
  "required": ["segments"],
  "properties": {
    "width": { "type": "integer", "minimum": 320, "maximum": 4096, "default": 1920 },
    "height": { "type": "integer", "minimum": 320, "maximum": 4096, "default": 1080 },
    "fps": { "type": "integer", "minimum": 12, "maximum": 60, "default": 60 },
    "palette": { "type": "string", "enum": ["paper", "neutral"], "default": "paper" },
    "crf": { "type": "integer", "minimum": 0, "maximum": 51, "default": 18 },
    "preset": { "type": "string", "default": "veryfast" },
    "audio": { "type": "string" },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "bottom": { "type": "integer", "minimum": 0 }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["family", "duration", "items"],
            "additionalProperties": true,
            "properties": {
              "family": { "const": "data-bar" },
              "duration": { "type": "number", "minimum": 2, "maximum": 30 },
              "title": { "type": "string", "minLength": 1, "maxLength": 60 },
              "unit": { "type": "string", "maxLength": 8 },
              "note": { "type": "string", "maxLength": 80 },
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": ["id", "label", "value"],
                  "additionalProperties": true,
                  "properties": {
                    "id": { "type": "string", "minLength": 1, "maxLength": 32 },
                    "label": { "type": "string", "minLength": 1, "maxLength": 12 },
                    "value": { "type": "number" },
                    "unit": { "type": "string", "maxLength": 8 }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": ["family", "duration", "items"],
            "additionalProperties": true,
            "properties": {
              "family": { "const": "data-line" },
              "duration": { "type": "number", "minimum": 2, "maximum": 30 },
              "title": { "type": "string", "minLength": 1, "maxLength": 60 },
              "unit": { "type": "string", "maxLength": 8 },
              "note": { "type": "string", "maxLength": 80 },
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": ["id", "label", "x", "value"],
                  "additionalProperties": true,
                  "properties": {
                    "id": { "type": "string", "minLength": 1, "maxLength": 32 },
                    "label": { "type": "string", "minLength": 1, "maxLength": 12 },
                    "x": { "type": "number" },
                    "value": { "type": "number" },
                    "unit": { "type": "string", "maxLength": 8 }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": ["family", "duration", "items"],
            "additionalProperties": true,
            "properties": {
              "family": { "const": "hierarchy" },
              "duration": { "type": "number", "minimum": 2, "maximum": 30 },
              "title": { "type": "string", "minLength": 1, "maxLength": 60 },
              "note": { "type": "string", "maxLength": 80 },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": ["id", "label"],
                  "additionalProperties": true,
                  "properties": {
                    "id": { "type": "string", "minLength": 1, "maxLength": 32 },
                    "label": { "type": "string", "minLength": 1, "maxLength": 12 },
                    "parent": { "type": "string", "minLength": 1, "maxLength": 32 }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": ["family", "duration", "items"],
            "additionalProperties": true,
            "properties": {
              "family": { "const": "cycle" },
              "duration": { "type": "number", "minimum": 2, "maximum": 30 },
              "title": { "type": "string", "minLength": 1, "maxLength": 60 },
              "note": { "type": "string", "maxLength": 80 },
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "required": ["id", "label"],
                  "additionalProperties": true,
                  "properties": {
                    "id": { "type": "string", "minLength": 1, "maxLength": 32 },
                    "label": { "type": "string", "minLength": 1, "maxLength": 10 },
                    "text": { "type": "string", "maxLength": 20 }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
